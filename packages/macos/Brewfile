# macOS Homebrew baseline
#
# 2026-09-04 从本机 Homebrew 状态手工核对生成，之后随 Git 维护。
# mise 作为本项目的任务运行器，也纳入 Brewfile。
#
# 这里只声明根 formula，不列出 Homebrew 自动维护的依赖树。
# 开发工具版本交给 mise；Homebrew Ruby 仅作为 CocoaPods 的依赖保留。

# 第三方 tap 与对应的 formula / cask 放在一起。
# 仅信任已经安装并纳入本基线的具体 formula，不信任整个第三方 tap。
tap "antoniorodr/memo"
brew "antoniorodr/memo/memo", trusted: true

tap "android/tap"
cask "android/tap/android-cli"

# 官方 formula
