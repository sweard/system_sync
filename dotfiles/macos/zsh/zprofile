# macOS 登录 shell 初始化。
if [[ -x /opt/homebrew/bin/brew ]]; then
  eval "$(/opt/homebrew/bin/brew shellenv)"
elif [[ -x /usr/local/bin/brew ]]; then
  eval "$(/usr/local/bin/brew shellenv)"
fi

# Homebrew 会前置自身路径，在 mise 加载前恢复用户命令的优先级。
mise_path_config="${XDG_CONFIG_HOME:-$HOME/.config}/zsh/path.sh"
if [[ -r "$mise_path_config" ]]; then
  source "$mise_path_config"
  _system_sync_user_path
  unfunction _system_sync_user_path
fi
unset mise_path_config
typeset -U path PATH
export PATH

# 非交互登录 Shell 一次加载完整环境；交互 Shell 由 .zshrc 激活并动态更新。
if [[ ! -o interactive ]] && command -v mise >/dev/null 2>&1; then
  eval "$(mise env -s zsh)"
fi
