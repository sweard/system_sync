# macOS 登录 shell 初始化。
if [[ -x /opt/homebrew/bin/brew ]]; then
  eval "$(/opt/homebrew/bin/brew shellenv)"
elif [[ -x /usr/local/bin/brew ]]; then
  eval "$(/usr/local/bin/brew shellenv)"
fi

toolbox_bin="$HOME/Library/Application Support/JetBrains/Toolbox/scripts"
[[ -d "$toolbox_bin" ]] && path=("${path[@]}" "$toolbox_bin")
unset toolbox_bin

if [[ -z "${ANDROID_HOME:-}" && -d "$HOME/Library/Android/sdk" ]]; then
  export ANDROID_HOME="$HOME/Library/Android/sdk"
fi
if [[ -n "${ANDROID_HOME:-}" ]]; then
  for android_bin in emulator tools platform-tools build-tools; do
    [[ -d "$ANDROID_HOME/$android_bin" ]] && path=("${path[@]}" "$ANDROID_HOME/$android_bin")
  done
  unset android_bin
fi

typeset -U path PATH
export PATH
