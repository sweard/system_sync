# Linux 登录 shell 初始化。仅在实际安装 Linuxbrew 时加载它。
if [[ -x /home/linuxbrew/.linuxbrew/bin/brew ]]; then
  eval "$(/home/linuxbrew/.linuxbrew/bin/brew shellenv)"
elif [[ -x "$HOME/.linuxbrew/bin/brew" ]]; then
  eval "$("$HOME/.linuxbrew/bin/brew" shellenv)"
fi

toolbox_bin="$HOME/.local/share/JetBrains/Toolbox/scripts"
[[ -d "$toolbox_bin" ]] && path=("${path[@]}" "$toolbox_bin")
unset toolbox_bin

if [[ -z "${ANDROID_HOME:-}" && -d "$HOME/Android/Sdk" ]]; then
  export ANDROID_HOME="$HOME/Android/Sdk"
fi
if [[ -n "${ANDROID_HOME:-}" ]]; then
  for android_bin in emulator tools platform-tools build-tools; do
    [[ -d "$ANDROID_HOME/$android_bin" ]] && path=("${path[@]}" "$ANDROID_HOME/$android_bin")
  done
  unset android_bin
fi

typeset -U path PATH
export PATH

# 登录但非交互的 Shell（包括部分 IDE）也能找到受管工具。
if command -v mise >/dev/null 2>&1; then
  eval "$(mise activate zsh --shims)"
fi
