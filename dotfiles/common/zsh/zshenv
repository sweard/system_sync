# 跨平台轻量入口。mise 尚未部署时也能找到官方安装器的位置。
[[ -d "$HOME/.local/bin" ]] && path=("$HOME/.local/bin" "${path[@]}")
mise_path_config="${XDG_CONFIG_HOME:-$HOME/.config}/zsh/path.sh"
if [[ -r "$mise_path_config" ]]; then
  source "$mise_path_config"
  _system_sync_user_path
  unfunction _system_sync_user_path
fi
unset mise_path_config

typeset -U path PATH
export PATH
